# =========================================================================
# FRAUDIO configuration
# Copy to `.env` and fill in. `.env` is git-ignored.
# =========================================================================

# ---- Server ----
PORT=5100
NODE_ENV=development

# ---- Google OAuth 2.0 ----
# Create an OAuth 2.0 Client ID (Web Application) in the Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Enable the "Google Drive API" for the project, then add:
#   Authorized JavaScript Origin: http://localhost:5174
#   Authorized Redirect URI:     http://localhost:5100/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Leave blank to auto-detect from the incoming request (good for local dev).
GOOGLE_REDIRECT_URI=

# Random long string used to sign session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# ---- AudioBookBay (audiobookbay.lu) ----
# Account used to scrape the What's New feed and fetch .torrent files.
ABB_USERNAME=
ABB_PASSWORD=
# Optional base URL override, useful if the domain rotates.
ABB_BASE_URL=https://audiobookbay.lu

# ---- Paths ----
# Data directory (library database, cover cache, offline audio cache, session).
# Relative paths resolve from the project root. Defaults to ./data
DATA_DIR=./data
# Where yt-dlp / ffmpeg binaries are cached. Defaults to ./bin
BIN_DIR=./bin

# ---- Public URL ----
# The public origin a remote torrent node calls back to, e.g.
# https://audio.example.com  (no trailing slash).
# Required for remote/VPS deployments; leave blank for local-only use.
PUBLIC_URL=

# ---- Torrent node (optional) ----
# Without a node, AudioBookBay downloads are disabled; everything else works.
# The node runs separately and calls back to FRAUDIO over the public URL above.
TORRENT_NODE_URL=
# Shared bearer token the node presents as `Authorization: Bearer <key>`.
TORRENT_NODE_KEY=
# Shared secret the node sends as the `x-node-secret` header on callbacks.
# Leave blank to disable webhook signature checking (not recommended).
TORRENT_NODE_WEBHOOK_SECRET=
# How long to wait for the node, in ms. Defaults to 15000.
TORRENT_NODE_TIMEOUT_MS=15000

# ---- YouTube Music ----
# Source for the music "New Releases" page. The default is YouTube Music's own
# new-releases feed; override only if you want to track a different listing.
YTM_NEW_RELEASES_URL=https://music.youtube.com/new_releases/albums

# ---- Torrent behaviour ----
# Max simultaneous webtorrent downloads. Keep this low; each one needs disk.
TORRENT_MAX_CONCURRENT=1
# Max disk bytes the offline audio cache may use. 0 = unlimited. Default 20 GB.
TORRENT_CACHE_MAX_BYTES=21474836480
# Delete the local file after it has been uploaded to Google Drive.
TORRENT_DELETE_AFTER_UPLOAD=true

# YouTube cookies (Netscape cookies.txt) for private music like Liked Music (list=LM).
# Alternative to the per-account path in Settings; users set it there if you leave this blank.
# YTM_COOKIES_FILE=C:\\secrets\\youtube-cookies.txt
