# TV Transcoder configuration
PORT=4300
HOST=0.0.0.0
# BASE_URL=http://localhost:4300 (leave blank to automatically use caller's host IP)

# Optional: path to ffmpeg binary
# FFMPEG_PATH=C:\path\to\ffmpeg.exe

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4300/auth/google/callback
