{
  "name": "tv-transcoder",
  "version": "1.0.0",
  "description": "Desktop video transcoder for local network Roku offload",
  "main": "electron-main.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "electron": "electron .",
    "electron:dev": "electron .",
    "build": "node scripts/build-setup.mjs",
    "build:setup": "node scripts/build-setup.mjs",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "transcoder",
    "roku",
    "ffmpeg",
    "hls"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.butfree.tvtranscoder",
    "productName": "TV Transcoder",
    "electronVersion": "31.7.7",
    "npmRebuild": false,
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "server.js",
      "electron-main.js",
      "package.json",
      ".env",
      "public/**/*",
      "bin/**/*"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "bin/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TV Transcoder",
      "artifactName": "TV-Transcoder-Setup-${version}.${ext}"
    }
  }
}
