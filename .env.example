# =========================================================================
# butfree.online - Unified Shared Environment Configuration Template
# Copy this file to .env and configure your secrets.
# =========================================================================
NODE_ENV=development
DOMAIN=butfree.online
BASE_URL=https://butfree.online

# ---- Session Security ----
SESSION_SECRET=change_this_to_a_secure_random_string_butfree_2026

# ---- Google OAuth 2.0 Credentials ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Per-Pillar OAuth Callback Endpoints:
GOOGLE_REDIRECT_URI_WELCOME=https://butfree.online/auth/google/callback
GOOGLE_REDIRECT_URI_COMICS=https://comics.butfree.online/api/auth/google/callback
GOOGLE_REDIRECT_URI_MUSIC=https://music.butfree.online/api/auth/google/callback
GOOGLE_REDIRECT_URI_TV=https://tv.butfree.online/auth/google/callback
GOOGLE_REDIRECT_URI_GAMES=https://games.butfree.online/auth/google/callback

# ---- Local Development Ports ----
PORT_WELCOME=8080
PORT_COMICS=3000
PORT_MUSIC=5100
PORT_TV=3001
PORT_DOWNLOADER=4000
PORT_GAMES=5500

# ---- Android Toolchain ----
TOOLCHAIN_DIR=./toolchain
ANDROID_HOME=./toolchain/android-sdk
JAVA_HOME=./toolchain/jdk

# ---- Downloader & Torrent Node Settings ----
DOWNLOADER_PORT=4000
DOWNLOADER_SECRET_KEY=change_this_shared_downloader_key_45678
MAX_CONCURRENT_DOWNLOADS=2
MAX_CONCURRENT_TRANSCODES=1
TORRENT_CACHE_MAX_BYTES=21474836480
TORRENT_DELETE_AFTER_UPLOAD=true

# ---- AudioBookBay (ABB) Scraper ----
ABB_USERNAME=
ABB_PASSWORD=
ABB_BASE_URL=https://audiobookbay.lu

# ---- ComixoloFree Settings ----
COMIC_CACHE_DIR=./comics/server/cache
COMIC_DATA_DIR=./comics/server/data

# ---- Fraudio Settings ----
MUSIC_DATA_DIR=./music/server/data
MUSIC_BIN_DIR=./music/server/bin
YTM_NEW_RELEASES_URL=https://music.youtube.com/new_releases/albums

# ---- Freevee (TV & Movies) Settings ----
TV_DATA_DIR=./tv/server/data
HLS_CHUNK_SECONDS=7200

# ---- FREEPLAY (Games) Settings ----
GAMES_DATA_DIR=./games/server/data
