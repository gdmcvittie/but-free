# butFREE Unified Downloader & Streaming Hub (VPS)
PORT=4000
DOWNLOADER_PORT=4000

# Shared secret key between apps and the downloader node.
# Leave blank to run open, or set to match DOWNLOADER_SECRET_KEY in butfree.online root .env
NODE_KEY=change_this_shared_downloader_key_45678
DOWNLOADER_SECRET_KEY=change_this_shared_downloader_key_45678
DASHBOARD_KEY=change_this_shared_downloader_key_45678

# Cache and payload landing directories
DOWNLOADS_DIR=./downloads
CACHE_DIR=./downloads

# Concurrency & Idle cleanup
MAX_CONCURRENT=2
MAX_STREAM_IDLE_MINUTES=10
ORPHAN_MAX_AGE_MINUTES=60
EOF